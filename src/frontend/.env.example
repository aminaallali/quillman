# Example Moshi WebSocket URL for Vercel deployment or local development
# When using Vite, prefix environment variables with VITE_
# Example: VITE_MOSHI_WS_URL=wss://your-modal-moshi-app-name.modal.run/ws
# Or for local development against a local Moshi server:
# VITE_MOSHI_WS_URL=ws://localhost:8000/ws

VITE_MOSHI_WS_URL=wss://your-modal-moshi-app-name-moshi-web.modal.run/ws
